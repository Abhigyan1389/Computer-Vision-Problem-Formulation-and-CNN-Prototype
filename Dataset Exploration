# ==========================================================
# COMPUTER VISION DATASET ANALYSIS
# ==========================================================

# This script analyzes:
# 1. Number of classes
# 2. Number of images per class
# 3. Sample images from each class
# 4. Image dimensions
# 5. Dataset imbalance

# ==========================================================
# IMPORT LIBRARIES
# ==========================================================

import os
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from PIL import Image

# ==========================================================
# LOAD CSV FILE
# ==========================================================

# Replace with your CSV filename
df = pd.read_csv("labels.csv")

print("First 5 Rows:")
print(df.head())

# ==========================================================
# CHECK COLUMN NAMES
# ==========================================================

print("\nColumn Names:")
print(df.columns)

# Assumption:
# filename column -> image path
# class column -> image label

image_col = 'filename'
label_col = 'class'

# ==========================================================
# NUMBER OF CLASSES
# ==========================================================

classes = df[label_col].unique()

num_classes = len(classes)

print("\n================================================")
print("NUMBER OF CLASSES")
print("================================================")

print("Classes:")
print(classes)

print("\nTotal Number of Classes:", num_classes)

# ==========================================================
# NUMBER OF IMAGES PER CLASS
# ==========================================================

class_counts = df[label_col].value_counts()

print("\n================================================")
print("NUMBER OF IMAGES PER CLASS")
print("================================================")

print(class_counts)

# ==========================================================
# BAR PLOT OF CLASS DISTRIBUTION
# ==========================================================

plt.figure(figsize=(8,5))

class_counts.plot(kind='bar')

plt.title("Images per Class")
plt.xlabel("Class")
plt.ylabel("Number of Images")

plt.xticks(rotation=45)

plt.show()

# ==========================================================
# SAMPLE IMAGES FROM EACH CLASS
# ==========================================================

print("\n================================================")
print("DISPLAYING SAMPLE IMAGES")
print("================================================")

plt.figure(figsize=(15, 8))

for i, cls in enumerate(classes):

    # Get first image of that class
    sample_path = df[df[label_col] == cls][image_col].iloc[0]

    # Open image
    img = Image.open(sample_path)

    # Plot image
    plt.subplot(2, 2, i+1)

    plt.imshow(img)

    plt.title(cls)

    plt.axis('off')

plt.tight_layout()
plt.show()

# ==========================================================
# IMAGE DIMENSION ANALYSIS
# ==========================================================

widths = []
heights = []

for img_path in df[image_col]:

    try:
        img = Image.open(img_path)

        width, height = img.size

        widths.append(width)
        heights.append(height)

    except Exception as e:
        print(f"Error loading image: {img_path}")
        print(e)

# ==========================================================
# IMAGE SIZE STATISTICS
# ==========================================================

print("\n================================================")
print("IMAGE DIMENSION ANALYSIS")
print("================================================")

print("Minimum Width :", min(widths))
print("Maximum Width :", max(widths))
print("Average Width :", np.mean(widths))

print("\nMinimum Height:", min(heights))
print("Maximum Height:", max(heights))
print("Average Height:", np.mean(heights))

# ==========================================================
# HISTOGRAM OF IMAGE DIMENSIONS
# ==========================================================

plt.figure(figsize=(10,5))

plt.hist(widths, bins=20, alpha=0.7, label='Widths')
plt.hist(heights, bins=20, alpha=0.7, label='Heights')

plt.title("Distribution of Image Dimensions")
plt.xlabel("Pixels")
plt.ylabel("Frequency")

plt.legend()

plt.show()

# ==========================================================
# DATASET IMBALANCE CHECK
# ==========================================================

print("\n================================================")
print("DATASET IMBALANCE ANALYSIS")
print("================================================")

max_count = class_counts.max()
min_count = class_counts.min()

imbalance_ratio = max_count / min_count

print("Largest Class Size :", max_count)
print("Smallest Class Size:", min_count)

print("\nImbalance Ratio:", round(imbalance_ratio, 2))

# ==========================================================
# INTERPRETATION OF IMBALANCE
# ==========================================================

if imbalance_ratio < 1.5:
    print("\nDataset is relatively balanced.")

elif imbalance_ratio < 3:
    print("\nDataset is moderately imbalanced.")

else:
    print("\nDataset is highly imbalanced.")

# ==========================================================
# FINAL SUMMARY
# ==========================================================

print("\n================================================")
print("FINAL DATASET SUMMARY")
print("================================================")

print(f"Total Images      : {len(df)}")
print(f"Number of Classes : {num_classes}")

print("\nClass Distribution:")
print(class_counts)

print("\nAnalysis Completed Successfully!")
